# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Catastro / mapas / IA (opcional)
GEOAPIFY_API_KEY=
NEXT_PUBLIC_GEOAPIFY_KEY=
ASSET_UPSERT_AFTER_CATASTRO_ENRICH=false
ANTHROPIC_API_KEY=

# Resend (envío de emails)
# Crear API key en https://resend.com/api-keys con el dominio "unihabitat.net" verificado.
RESEND_API_KEY=
# Remitente de los correos (debe estar en un dominio verificado en Resend).
EMAIL_FROM=Unihabitat <info@unihabitat.net>
# Destinatario interno (formularios de contacto, solicitud de información y ofertas sin vendedor asignado).
EMAIL_SUPPORT=info@unihabitat.net
# En desarrollo, poner "true" para registrar los envíos en consola sin enviarlos.
EMAIL_DRY_RUN=false
# URL base pública (emails, redirects). En Vercel debe ser https://www.tu-dominio.com
NEXT_PUBLIC_APP_URL=
# Opcional: origen canónico solo servidor (no se bakea en build). Si NEXT_PUBLIC_APP_URL
# quedó como http://localhost en un deploy, usar aquí la URL de producción para links de Auth/emails.
APP_ORIGIN=

# Solo staging/local: muestra /admin/guia-staging (tutorial). NUNCA true en producción Vercel.
# Si se omite, la guía se muestra automáticamente en localhost, 127.0.0.1, hostnames con
# "unihabitat-staging", VERCEL_ENV=preview, o NODE_ENV !== production.
# En www.unihabitat.net / unihabitat.net la guía nunca aparece aunque esta flag esté en true.
NEXT_PUBLIC_SHOW_STAGING_GUIDE=false

# Cloudflare Turnstile (opcional, protección anti-bot en formulario de contacto)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Forzar logins demo en producción (no recomendado, solo testing)
# ALLOW_DEV_AUTH=false

# Secreto del cron de compradores inactivos (Vercel Cron → /api/cron/reasignar-compradores).
# La cabecera tiene que ser exactamente: Authorization: Bearer <CRON_SECRET>
# Sin este valor la ruta responde 401 y no reasigna. El listado de compradores
# también aplica la regla de 90 días al abrirse.
CRON_SECRET=

# Cruce de demanda (lunes y jueves 07:00 UTC → /api/cron/cruce-demanda).
# false (o ausente): registra oportunidades en el CRM y no envía email.
# true: email resumen al comprador y copia al agente, respetando EMAIL_DRY_RUN.
CRUCE_DEMANDA_EMAIL_ENABLED=false
# Máximo de oportunidades nuevas por comprador y envío.
CRUCE_DEMANDA_LIMITE=5

# WhatsApp Cloud API (Meta). Desactivado por defecto: aún no hay número de WhatsApp Business.
# WHATSAPP_ENABLED=true activa el envío y el webhook /api/whatsapp/webhook.
# WHATSAPP_DRY_RUN vacío o true solo escribe un log y no llama a la API.
# Hay que poner WHATSAPP_DRY_RUN=false para enviar de verdad.
# La plantilla de Meta debe tener dos variables de cuerpo: {{1}} nombre, {{2}} resumen.
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_OPORTUNIDADES=
WHATSAPP_VERIFY_TOKEN=
